{
  "name": "yciswhatisee",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3100",
    "dev:https": "next dev -p 3100 --experimental-https -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "setup:agent": "node scripts/setup-elevenlabs-agent.mjs",
    "mock:ploid": "node mock-ploid/server.mjs",
    "test:mock": "MOCK_LATENCY=0 MOCK_RUN_DELAY_MS=0 node mock-ploid/contract-test.mjs",
    "tunnel": "cloudflared tunnel --url http://localhost:3100",
    "test:interview": "node scripts/test-interview.mjs",
    "demo": "next build && next start -p 3100"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@elevenlabs/react": "^1.23.1",
    "@types/qrcode": "^1.5.6",
    "next": "16.4.6",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
