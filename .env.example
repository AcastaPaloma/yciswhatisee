ELEVENLABS_API_KEY=
PLOID_API_KEY=
# Empty = built-in mock (in-process). https://api.ploid.com = real API. http://localhost:4010 = standalone mock
PLOID_BASE_URL=
# Mock only: route every candidate email to a real inbox for demos ({slug}, {first})
MOCK_EMAIL_OVERRIDE=
# Created by `npm run setup:agent`
ELEVENLABS_AGENT_ID=
ELEVENLABS_TOOL_ID=
# Optional: Claude extracts the role spec from the job posting
ANTHROPIC_API_KEY=
# Public URL for room links and QR codes (e.g. your npm run tunnel URL)
NEXT_PUBLIC_APP_URL=
